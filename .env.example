# Copy this file to `.env` and fill in your values.
# Never commit the real `.env` — it is git-ignored.

# API key for an OpenAI-compatible provider (OpenRouter, NVIDIA NIM, OpenAI, ...)
OPENROUTER_API_KEY=your_api_key_here

# Base endpoint for the chat completions API
BASE_URL=https://openrouter.ai/api/v1

# Model name
MODEL=meta/llama-3.3-70b-instruct

# Force mock mode even when a key is present: 1 / true / yes / on
LLM_USE_MOCK=0

# Maximum ReAct loop iterations before giving a best-effort answer
REACT_MAX_ITERATIONS=8

# Tool execution timeout in seconds
TOOL_TIMEOUT_SECONDS=15

# LLM request timeout / retries / temperature
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# Workspace root tools (read_file/write_file/list_dir/shell) are sandboxed to.
# Empty = project root.
WORKSPACE_ROOT=

# Cap conversation history records kept on disk
MAX_HISTORY_RECORDS=200

# Cap ReAct scratchpad chars carried between iterations
MAX_SCRATCHPAD_CHARS=12000
